{# templates/blog/page2.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}CV - Berthod Nathanael{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    #cv-content {
      max-width: 900px;
      margin: 3rem auto;
      background: #ffffff;
      color: #000;
      padding: 2.5rem;
      border-radius: 0.5rem;
    }
    @media print {
      .navbar,
      .no-print {
        display: none !important;
      }
      body {
        background: #ffffff;
      }
      #cv-content {
        margin: 0;
        padding: 0;
        border-radius: 0;
      }
    }
  </style>
{% endblock %}

{% block body %}
<div id="cv-content">
  {# === COLLE ICI TON VRAI CV EN HTML (titres, listes, sections…) === #}

  <header class="mb-4">
    <h1 class="mb-1">Berthod Nathanael</h1>
    <p class="mb-0">Étudiant en BUT Réseaux &amp; Télécommunications – Groupe TP B2</p>
    <p class="mb-0 text-muted">Coordonnées (berthod.nathanael@gmail.com, 0672190581, Allinges)</p>
  </header>

  <section class="mb-4">
    <h2>Formations</h2>
    <ul>
      <li><strong>BUT Réseaux &amp; Télécommunications</strong> – IUT de Roanne</li>
      <li><strong>Baccalauréat Générale</strong> – Lycée Anna de Noailles</li>
    </ul>
  </section>

  <section class="mb-4">
    <h2>Expériences professionnelles</h2>
    <ul>
      <li><strong>Projet / Stage …</strong> – tâches, techno, résultats…</li>
    </ul>
  </section>

  <section class="mb-4">
    <h2>Compétences</h2>
    <h3>Techniques</h3>
    <ul>
      <li>Réseaux : …</li>
      <li>Systèmes : …</li>
      <li>Web : …</li>
    </ul>
    <h3>Transversales</h3>
    <ul>
      <li>Travail en équipe, autonomie, communication…</li>
    </ul>
  </section>
</div>

<div class="text-center mb-4 no-print">
  <button class="btn btn-outline-primary" onclick="window.print()">
    Imprimer ce CV
  </button>
</div>
{% endblock %}
