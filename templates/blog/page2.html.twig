{# templates/blog/page2.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}CV - Berthod Nathanael{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    #cv-content {
      max-width: 900px;
      margin: 3rem auto;
      background: #ffffff;
      color: #000;
      padding: 2.5rem;
      border-radius: 0.5rem;
    }
    @media print {
      .navbar,
      .no-print {
        display: none !important;
      }
      body {
        background: #ffffff;
      }
      #cv-content {
        margin: 0;
        padding: 0;
        border-radius: 0;
      }
    }
  </style>
{% endblock %}

{% block body %}
<div id="cv-content">

  <header class="mb-4">
    <h1 class="mb-1">Berthod Nathanael</h1>
    <p class="mb-0">Étudiant en BUT Réseaux &amp; Télécommunications – Groupe TP B2</p>
    <p class="mb-0 text-muted">berthod.nathanael@gmail.com • 06 72 19 05 81 • Allinges • née le 19 novembre 2007</p>
    <p class="mb-0">Administrateur réseau</p>
  </header>

  <section class="mb-4">
    <h2>Formations</h2>
    <ul>
      <li>
        <strong>BUT Réseaux &amp; Télécommunications</strong> – IUT de Roanne - 2025 A 202.  
        <br><span class="text-muted">Parcours orienté administration des réseaux, systèmes et développement d’outils pour les R&amp;T (en cours).</span>
      </li>
      <li>
        <strong>Baccalauréat général</strong> – Lycée Anna de Noailles - 2023 A 2025  
        <br><span class="text-muted">Spécialités scientifiques (donnant une base solide pour les réseaux, l’informatique et l’électricité).</span>
      </li>
    </ul>
  </section>

  <section class="mb-4">
    <h2>Expériences académiques et projets</h2>
    <ul>
      <li>
        <strong>SAÉ réseau – Étude et extension d’un réseau d’entreprise</strong>  
        <br><span class="text-muted">
          Conception d’une topologie avec plusieurs LAN (RH, ventes, production), adressage IP, configuration de switchs et de VLAN, tests de connectivité (ping, traceroute).
        </span>
      </li>
      <li>
        <strong>Projet services Linux</strong>  
        <br><span class="text-muted">
          Installation et administration de services réseau sous Linux (SSH, partage de fichiers…), utilisation de machines virtuelles pour les tests.
        </span>
      </li>
      <li>
        <strong>Portfolio web avec Symfony</strong>  
        <br><span class="text-muted">
          Création d’un site personnel avec Symfony, Twig, Bootstrap et un thème Bootswatch pour présenter CV, compétences et projets, mise en place de formulaires et d’une page d’e‑portfolio.
        </span>
      </li>
    </ul>
  </section>

  <section class="mb-4">
    <h2>Compétences</h2>

    <h3>Techniques</h3>
    <ul>
      <li>
        <strong>Réseaux :</strong> adressage IP, configurations de base sur switch, VLAN, tests de connectivité (ping, traceroute).
      </li>
      <li>
        <strong>Systèmes :</strong> environnement Linux, ligne de commande, installation et configuration de services réseau, notions d’architecture des systèmes numériques et de codage de l’information.
      </li>
      <li>
        <strong>Développement / Web :</strong> HTML, CSS, Bootstrap/Bootswatch, bases de PHP avec Symfony et Twig, création de pages de portfolio.
      </li>
      <li>
        <strong>Outils :</strong> VirtualBox et gestion de projets via Git (notions).
      </li>
    </ul>

    <h3>Transversales</h3>
    <ul>
      <li>Travail en équipe sur projets tutorés et SAÉ, communication avec les autres membres du groupe.</li>
      <li>Autonomie et curiosité pour apprendre de nouvelles technologies (réseaux, Linux, frameworks web).</li>
      <li>Organisation et rigueur dans la rédaction de comptes‑rendus et de documentations techniques.</li>
    </ul>
  </section>

  <section class="mb-0">
    <h2>Centres d’intérêt</h2>
    <ul>
      <li>Badminton : pratique régulière, développement de la réactivité, de l’endurance et de l’esprit d’équipe.</li>
      <li>Manga et univers graphiques : sens de la narration et de l’esthétique utile pour le design d’interfaces.</li>
      <li>Dessin (traditionnel et numérique) : attention au détail, patience, créativité, utiles pour les schémas réseau et supports visuels.</li>
    </ul>
  </section>

</div>

<div class="text-center mb-4 no-print">
  <button class="btn btn-outline-primary" onclick="window.print()">
    Imprimer ce CV
  </button>
</div>
{% endblock %}
