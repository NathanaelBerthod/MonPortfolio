{% extends 'base.html.twig' %}

{% block title %}Projets - Nathanael{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  :root{
    --accent: #4ade80;
    --stroke: rgba(255,255,255,.10);
  }

  .projects-hero{
    max-width: 980px;
    margin: 0 auto 2rem;
    text-align: center;
    padding-top: 2rem;
  }

  .projects-hero h1{
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: .5rem;
  }

  .projects-hero p{
    max-width: 820px;
    margin: 0 auto;
  }

  .project-card{
    border: 1px solid var(--stroke);
    background: rgba(255,255,255,.03);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card-top{
    padding: 1.4rem;
    border-bottom: 1px solid rgba(255,255,255,.05);
  }

  .project-card-title{
    font-weight: 800;
    font-size: 1.1rem;
    margin: 0 0 .4rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-status{
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .05em;
    padding: .3rem .6rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.15);
    background: rgba(0,0,0,.25);
    white-space: nowrap;
  }

  .project-status.done{
    background: rgba(74,222,128,.15);
    border-color: rgba(74,222,128,.35);
    color: #4ade80;
  }

  .project-status.wip{
    background: rgba(245,158,11,.15);
    border-color: rgba(245,158,11,.35);
    color: #f59e0b;
  }

  .project-sub{
    font-size: .9rem;
    color: rgba(255,255,255,.68);
    margin: 0;
    line-height: 1.45;
  }

  .project-card-body{
    padding: 1.4rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-desc{
    font-size: .95rem;
    line-height: 1.5;
    color: rgba(255,255,255,.75);
    margin-bottom: 1rem;
  }

  .project-section{
    margin-bottom: 1rem;
  }

  .project-section-title{
    font-size: .8rem;
    font-weight: 800;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-bottom: .3rem;
  }

  .project-section-text{
    font-size: .92rem;
    color: rgba(255,255,255,.72);
    line-height: 1.5;
  }

  .project-tags{
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    margin: .8rem 0 1rem 0;
  }

  .project-tag{
    display: inline-block;
    padding: .25rem .55rem;
    border-radius: 999px;
    font-size: .75rem;
    font-weight: 750;
    border: 1px solid rgba(255,255,255,.15);
    background: rgba(0,0,0,.25);
    color: rgba(255,255,255,.8);
  }

  .project-tag.tech{
    background: rgba(56,189,248,.15);
    border-color: rgba(56,189,248,.35);
    color: #38bdf8;
  }

  .project-links{
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .project-link{
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .45rem .85rem;
    border-radius: 999px;
    font-size: .85rem;
    font-weight: 700;
    border: 1px solid rgba(255,255,255,.15);
    background: rgba(0,0,0,.25);
    color: rgba(255,255,255,.85);
    text-decoration: none;
    transition: all .15s ease;
  }

  .project-link:hover{
    background: var(--accent);
    color: #0b0d12;
    border-color: var(--accent);
  }

  .project-link.primary{
    background: var(--accent);
    color: #0b0d12;
    border-color: var(--accent);
  }

  .project-link.primary:hover{
    background: rgba(74,222,128,.85);
  }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
  <div style="max-width: 980px; margin: 0 auto;">

    <header class="projects-hero">
      <h1>Mes projets</h1>
      <p class="lead text-muted">
        Sélection de projets réalisés en cours de BUT. Chaque carte présente l'objectif,
        ce que j'ai fait, et les technologies/outils utilisés.
      </p>
    </header>

    <div class="row g-4">

      {# Projet 1: SAE1.02 #}
      <div class="col-12 col-lg-6">
        <article class="card project-card">
          <div class="project-card-top">
            <div class="project-card-title">
              <span>Extension réseau d'entreprise (SAE1.02)</span>
              <span class="project-status done">Done</span>
            </div>
            <p class="project-sub">
              Conception d'une infrastructure multi-VLAN sécurisée avec 3 services.
            </p>
          </div>

          <div class="project-card-body">
            <p class="project-desc">
              Simulation d'un technicien réseau qui agrandit l'infrastructure d'une
              petite entreprise. Mise en place de VLANs séparés pour RH, commercial et production.
            </p>

            <div class="project-section">
              <div class="project-section-title">Objectif</div>
              <div class="project-section-text">
                Concevoir une topologie multi-LAN, configurer les VLANs,
                tester la connectivité (ping/traceroute), et documenter.
              </div>
            </div>

            <div class="project-section">
              <div class="project-section-title">Ce que j'ai fait</div>
              <div class="project-section-text">
                <ul style="margin: 0; padding-left: 1.2rem; font-size: .92rem;">
                  <li>Analyse de trames avec Wireshark (CDP, ARP, ICMP)</li>
                  <li>Récupération du fichier config sur serveur TFTP</li>
                  <li>Création VLANs 30/31/32 (prod/commercial/RH) + VLAN 150 (gestion)</li>
                  <li>Configuration ports trunk &amp; access</li>
                  <li>Sécurité SSH pour accès distant</li>
                  <li>Tests de connectivité entre VLANs</li>
                </ul>
              </div>
            </div>

            <div class="project-tags">
              <span class="project-tag tech">Cisco IOS</span>
              <span class="project-tag tech">VLAN</span>
              <span class="project-tag tech">SSH</span>
              <span class="project-tag tech">Wireshark</span>
              <span class="project-tag tech">Packet Tracer</span>
              <span class="project-tag tech">TFTP</span>
            </div>

            <div class="project-links">
              <a href="{{ asset('docs/SAE1.02-B2-Berthod-Nathanael.pdf') }}"
                 class="project-link primary"
                 target="_blank"
                 rel="noreferrer">
                📄 Compte-rendu complet
              </a>
              <a href="{{ asset('docs/Configuration-Personnel.txt') }}"
                 class="project-link"
                 target="_blank"
                 rel="noreferrer">
                🔧 Config switch
              </a>
              <a href="{{ asset('docs/Installation-TFTP64-Berthod-Nathanael-1.pdf') }}"
                 class="project-link"
                 target="_blank"
                 rel="noreferrer">
                📦 TFTP64 guide
              </a>
            </div>
          </div>
        </article>
      </div>

      {# Projet 2: SAE1.03 #}
      <div class="col-12 col-lg-6">
        <article class="card project-card">
          <div class="project-card-top">
            <div class="project-card-title">
              <span>Qualification réseau &amp; Wi-Fi (SAE1.03)</span>
              <span class="project-status done">Done</span>
            </div>
            <p class="project-sub">
              Mesures d'une infrastructure réelle : câblage, Wi-Fi, coûts.
            </p>
          </div>

          <div class="project-card-body">
            <p class="project-desc">
              Travail sur site de l'IUT Roanne : audit d'une salle informatique
              (G_007), qualification du câblage et analyse Wi-Fi avec testeur NetScout.
            </p>

            <div class="project-section">
              <div class="project-section-title">Objectif</div>
              <div class="project-section-text">
                Mesurer la qualité du câblage, analyser la couverture Wi-Fi,
                et proposer des améliorations avec devis.
              </div>
            </div>

            <div class="project-section">
              <div class="project-section-title">Ce que j'ai fait</div>
              <div class="project-section-text">
                <ul style="margin: 0; padding-left: 1.2rem; font-size: .92rem;">
                  <li>33 mesures Wi-Fi à différents endroits (NetScout AirCheck G2)</li>
                  <li>Tests de câblage avec FLUKE Networks CableIO Qualification Tester</li>
                  <li>Identification problèmes : saturation 2.4 GHz (canaux 1/6/11)</li>
                  <li>Devis détaillé (baie, câbles, panneaux, main d'œuvre)</li>
                  <li>Cartographie salle + recommandations (5 GHz, répéteurs Wi-Fi)</li>
                </ul>
              </div>
            </div>

            <div class="project-tags">
              <span class="project-tag tech">Wi-Fi 802.11</span>
              <span class="project-tag tech">Câblage Cat.6</span>
              <span class="project-tag tech">NetScout AirCheck</span>
              <span class="project-tag tech">Audit infra</span>
              <span class="project-tag tech">Devis</span>
            </div>

            <div class="project-links">
              <a href="{{ asset('docs/SAe-1.03.pdf') }}"
                 class="project-link primary"
                 target="_blank"
                 rel="noreferrer">
                📄 Rapport complet (mesures + devis)
              </a>
            </div>
          </div>
        </article>
      </div>

      {# Projet 3: Portfolio #}
      <div class="col-12 col-lg-6">
        <article class="card project-card">
          <div class="project-card-top">
            <div class="project-card-title">
              <span>Portfolio Symfony</span>
              <span class="project-status done">Done</span>
            </div>
            <p class="project-sub">
              Site personnel responsive : CV, projets, compétences.
            </p>
          </div>

          <div class="project-card-body">
            <p class="project-desc">
              Site créé avec Symfony &amp; Twig, thème Bootswatch. Permet de présenter
              mon parcours, mes compétences, et mes projets en format web.
            </p>

            <div class="project-section">
              <div class="project-section-title">Objectif</div>
              <div class="project-section-text">
                Créer un portfolio web professionnel qui présente mon parcours
                de manière claire et accessible.
              </div>
            </div>

            <div class="project-section">
              <div class="project-section-title">Ce que j'ai fait</div>
              <div class="project-section-text">
                <ul style="margin: 0; padding-left: 1.2rem; font-size: .92rem;">
                  <li>Structure Symfony (controllers/templates/routes)</li>
                  <li>Templates Twig avec héritage base.html.twig</li>
                  <li>Pages : accueil, à propos, CV, compétences, projets</li>
                  <li>Design responsive (Bootstrap + Bootswatch Slate)</li>
                  <li>Mode print pour CV imprimable</li>
                  <li>Accessibilité &amp; SEO basique</li>
                </ul>
              </div>
            </div>

            <div class="project-tags">
              <span class="project-tag tech">Symfony</span>
              <span class="project-tag tech">Twig</span>
              <span class="project-tag tech">Bootstrap</span>
              <span class="project-tag tech">PHP</span>
              <span class="project-tag tech">Git</span>
            </div>

            <div class="project-links">
              <a href="#" class="project-link">
                🌐 Voir le site
              </a>
              <a href="#" class="project-link">
                📂 Repo GitHub
              </a>
            </div>
          </div>
        </article>
      </div>

      {# Projet 4: Services Linux (WIP) #}
      <div class="col-12 col-lg-6">
        <article class="card project-card">
          <div class="project-card-top">
            <div class="project-card-title">
              <span>Services Linux &amp; VM</span>
              <span class="project-status wip">WIP</span>
            </div>
            <p class="project-sub">
              Mise en place de services réseau sur machines virtuelles.
            </p>
          </div>

          <div class="project-card-body">
            <p class="project-desc">
              Exploration des services réseau essentiels (SSH, partage de fichiers)
              sur Linux, avec tests reproductibles en environnement VM.
            </p>

            <div class="project-section">
              <div class="project-section-title">Objectif</div>
              <div class="project-section-text">
                Installer et configurer des services réseau standards (SSH, Samba, DHCP)
                et documenter les bonnes pratiques.
              </div>
            </div>

            <div class="project-section">
              <div class="project-section-title">En cours</div>
              <div class="project-section-text">
                Installation sur Ubuntu &amp; tests de connectivité depuis clients Windows/Linux.
              </div>
            </div>

            <div class="project-tags">
              <span class="project-tag tech">Linux (Ubuntu)</span>
              <span class="project-tag tech">SSH</span>
              <span class="project-tag tech">Samba</span>
              <span class="project-tag tech">Bash</span>
              <span class="project-tag tech">VM VirtualBox</span>
            </div>

            <div class="project-links">
              <span style="padding: .45rem .85rem; font-size: .85rem; color: rgba(255,255,255,.5);">
                📋 Documentation en préparation
              </span>
            </div>
          </div>
        </article>
      </div>

    </div>

  </div>
</div>
{% endblock %}
