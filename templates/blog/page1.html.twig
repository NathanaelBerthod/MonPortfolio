{% extends 'base.html.twig' %}

{% block title %}Pour en savoir plus - Nathanael{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .about-hero {
      max-width: 900px;
      margin: 3rem auto 2rem;
      text-align: center;
    }
    .about-hero h1 {
      font-size: clamp(2.3rem, 4vw, 2.8rem);
      margin-bottom: 0.5rem;
    }
    .about-hero p {
      font-size: 1.05rem;
    }
    .about-divider {
      width: 80px;
      height: 3px;
      margin: 1.5rem auto 0;
      border-radius: 999px;
      background: rgba(255,255,255,0.6);
    }
    .about-section-title {
      font-size: 1.4rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      text-align: center;
    }
    .about-icon {
      font-size: 2rem;
      opacity: 0.9;
      margin-bottom: 0.5rem;
    }
    .card-soft {
      background-color: rgba(0,0,0,0.15);
      border: 1px solid rgba(255,255,255,0.08);
      backdrop-filter: blur(2px);
    }
  </style>
{% endblock %}

{% block body %}
<div class="container py-5">

  <section class="about-hero">
    <h1>En savoir plus sur moi</h1>
    <p class="text-muted">
      Ce qui me motive en dehors des cours&nbsp;: sport, univers graphiques et projets
      personnels qui complètent mon profil d’étudiant en BUT Réseaux &amp; Télécommunications.
    </p>
    <div class="about-divider"></div>
  </section>

  {# Loisirs & passions #}
  <section class="mb-5">
    <h2 class="about-section-title">Loisirs &amp; passions</h2>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card h-100 card-soft">
          <div class="card-body text-center">
            <div class="about-icon">🏸</div>
            <h3 class="card-title">Badminton</h3>
            <p class="card-text">
              Sport que je pratique régulièrement. Il développe ma réactivité, mon endurance
              et l’esprit d’équipe, des qualités que je retrouve dans le travail en projet
              informatique et réseau.
            </p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 card-soft">
          <div class="card-body text-center">
            <div class="about-icon">📚</div>
            <h3 class="card-title">Manga</h3>
            <p class="card-text">
              Univers graphiques et narratifs qui nourrissent mon imagination, mon sens visuel
              et ma créativité. Ils influencent la façon dont j’aborde le design d’interfaces
              et l’expérience utilisateur.
            </p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 card-soft">
          <div class="card-body text-center">
            <div class="about-icon">✏️</div>
            <h3 class="card-title">Dessin</h3>
            <p class="card-text">
              Dessin traditionnel et numérique, qui m’apprend patience, précision
              et attention au détail. Ces compétences m’aident aussi pour la réalisation
              de schémas réseau et de documentations claires.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {# Envies & projets #}
  <section class="row g-4">
    <div class="col-md-6">
      <div class="card h-100 card-soft border-success">
        <div class="card-body">
          <h3 class="card-title">Envies</h3>
          <p class="card-text">
            Continuer à progresser en réseaux, cybersécurité et administration système,
            tout en gardant un pied dans le développement web et l’UX pour comprendre
            la vision globale d’un projet.
          </p>
          <p class="card-text">
            M’impliquer dans des projets concrets (projets tutorés, labs personnels,
            éventuels hackathons) afin de transformer la théorie en expériences réelles.
          </p>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card h-100 card-soft border-info">
        <div class="card-body">
          <h3 class="card-title">Projets</h3>
          <p class="card-text">
            Construire un portfolio technique solide&nbsp;: topologies réseaux, services
            Linux et Docker, petits outils d’automatisation et sites web réalisés en Symfony.
          </p>
          <p class="card-text">
            Documenter chaque projet (objectifs, technologies, difficultés, résultats)
            pour pouvoir le présenter clairement en entretien ou lors de futures candidatures
            en alternance ou premier emploi.
          </p>
        </div>
      </div>
    </div>
  </section>

</div>
{% endblock %}
