{% extends 'base.html.twig' %}

{% block title %}Accueil - Portfolio Nathanael{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .home-wrapper {
      min-height: calc(100vh - 120px);
      display: flex;
      align-items: center;
    }
    .home-title {
      font-size: clamp(3rem, 5vw, 3.8rem);
      font-weight: 600;
    }
    .home-subtitle {
      font-size: 1.3rem;
    }
    .home-text {
      font-size: 1.05rem;
    }
    .home-buttons a {
      font-size: 1.05rem;
      padding: 0.9rem 2.6rem;
    }
    .home-divider {
      width: 80px;
      height: 3px;
      margin: 1.5rem auto 0;
      border-radius: 999px;
      background: rgba(255,255,255,0.6);
    }
    .home-tagline {
      font-size: 0.95rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .home-pill-row {
      margin-top: 2.5rem;
      font-size: 0.9rem;
    }
    .home-pill {
      display: inline-block;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.3);
      padding: 0.35rem 0.9rem;
      margin: 0.15rem 0.3rem;
      font-size: 0.85rem;
      opacity: 0.9;
    }
  </style>
{% endblock %}

{% block body %}
<div class="container py-5 home-wrapper">

  <div class="w-100 text-center">

    <div class="home-tagline text-muted mb-3">
      PORTFOLIO ÉTUDIANT • BUT R&amp;T
    </div>

    <header class="mb-4">
      <h1 class="home-title mb-2">Berthod Nathanael</h1>
      <p class="home-subtitle mb-2">
        Étudiant en BUT Réseaux &amp; Télécommunications – Groupe TP B2
      </p>
      <p class="home-text mb-0">
        Portfolio académique réalisé avec Symfony, Bootstrap &amp; Bootswatch, présentant mon parcours,
        mes compétences et quelques projets personnels.
      </p>
      <div class="home-divider"></div>
    </header>

    <section class="my-4">
      <p class="home-text text-muted mb-4">
        Choisissez où commencer&nbsp;: découvrir mon CV, en savoir plus sur mes loisirs &amp; passions
        ou parcourir mon e‑portfolio de compétences.
      </p>

      <div class="home-buttons d-flex justify-content-center flex-wrap gap-3 mb-4">
        <a href="{{ path('page2') }}" class="btn btn-light btn-lg text-dark">
          CV
        </a>
        <a href="{{ path('page1') }}" class="btn btn-outline-light btn-lg">
          Loisirs &amp; passions
        </a>
        <a href="{{ path('page3') }}" class="btn btn-outline-light btn-lg">
          E‑portfolio
        </a>
      </div>

      <div class="home-pill-row text-muted">
        <span class="home-pill">Réseaux &amp; Internet</span>
        <span class="home-pill">Linux &amp; services</span>
        <span class="home-pill">Docker &amp; labs</span>
        <span class="home-pill">Développement web</span>
        <span class="home-pill">Badminton</span>
        <span class="home-pill">Manga &amp; dessin</span>
      </div>
    </section>

  </div>

</div>
{% endblock %}
